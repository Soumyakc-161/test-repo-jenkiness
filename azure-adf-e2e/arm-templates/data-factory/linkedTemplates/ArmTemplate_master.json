{
    "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "factoryName": {
            "type": "string",
            "metadata": "Data Factory name",
            "defaultValue": "CloudFrameDataFactory"
        },
        "CFT_Sink_AzureBlobStorage_connectionString": {
            "type": "secureString",
            "metadata": "Secure string for 'connectionString' of 'CFT_Sink_AzureBlobStorage'"
        },
        "CFT_Sql_Server1_password": {
            "type": "secureString",
            "metadata": "Secure string for 'password' of 'CFT_Sql_Server1'"
        },
        "new_cft_SqlServer1_password": {
            "type": "secureString",
            "metadata": "Secure string for 'password' of 'new_cft_SqlServer1'"
        },
        "CFT_Sql_Server1_properties_typeProperties_server": {
            "type": "string",
            "defaultValue": "LAPTOP-9GFNROJ6\\SQLEXPRESS"
        },
        "CFT_Sql_Server1_properties_typeProperties_database": {
            "type": "string",
            "defaultValue": "NetflixDB"
        },
        "CFT_Sql_Server1_properties_typeProperties_userName": {
            "type": "string",
            "defaultValue": "sa"
        },
        "new_cft_SqlServer1_properties_typeProperties_server": {
            "type": "string",
            "defaultValue": "SURAJ\\SQLEXPRESS"
        },
        "new_cft_SqlServer1_properties_typeProperties_database": {
            "type": "string",
            "defaultValue": "NetflixDB"
        },
        "new_cft_SqlServer1_properties_typeProperties_userName": {
            "type": "string",
            "defaultValue": "sa"
        },
        "containerUri": {
            "type": "string",
            "metadata": "URI to storage account containing linked ARM templates"
        },
        "containerSasToken": {
            "type": "string",
            "metadata": "Sas token to storage account containing linked ARM templates"
        }
    },
    "variables": {
        "factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
    },
    "resources": [
        {
            "name": "CloudFrameDataFactory_ArmTemplate_0",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2024-03-01",
            "properties": {
                "mode": "incremental",
                "templateLink": {
                    "uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "factoryName": {
                        "value": "[parameters('factoryName')]"
                    },
                    "CFT_Sql_Server1_password": {
                        "value": "[parameters('CFT_Sql_Server1_password')]"
                    },
                    "new_cft_SqlServer1_password": {
                        "value": "[parameters('new_cft_SqlServer1_password')]"
                    },
                    "CFT_Sink_AzureBlobStorage_connectionString": {
                        "value": "[parameters('CFT_Sink_AzureBlobStorage_connectionString')]"
                    },
                    "CFT_Sql_Server1_properties_typeProperties_server": {
                        "value": "[parameters('CFT_Sql_Server1_properties_typeProperties_server')]"
                    },
                    "CFT_Sql_Server1_properties_typeProperties_database": {
                        "value": "[parameters('CFT_Sql_Server1_properties_typeProperties_database')]"
                    },
                    "CFT_Sql_Server1_properties_typeProperties_userName": {
                        "value": "[parameters('CFT_Sql_Server1_properties_typeProperties_userName')]"
                    },
                    "new_cft_SqlServer1_properties_typeProperties_server": {
                        "value": "[parameters('new_cft_SqlServer1_properties_typeProperties_server')]"
                    },
                    "new_cft_SqlServer1_properties_typeProperties_database": {
                        "value": "[parameters('new_cft_SqlServer1_properties_typeProperties_database')]"
                    },
                    "new_cft_SqlServer1_properties_typeProperties_userName": {
                        "value": "[parameters('new_cft_SqlServer1_properties_typeProperties_userName')]"
                    }
                }
            },
            "dependsOn": []
        }
    ]
}