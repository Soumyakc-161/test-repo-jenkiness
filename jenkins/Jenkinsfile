pipeline {
    agent any

    stages {

        stage('Checkout DEV Repo') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: 'refs/heads/feature/test_repo_dev']],
                    userRemoteConfigs: [[
                        url: 'https://your-dev-repo-url.git'
                    ]]
                ])
            }
        }

        stage('Azure Login') {
            steps {
                withCredentials([
                    string(credentialsId: 'AZ_CLIENT_ID', variable: 'CID'),
                    string(credentialsId: 'AZ_CLIENT_SECRET', variable: 'CSEC'),
                    string(credentialsId: 'AZ_TENANT_ID', variable: 'TID'),
                    string(credentialsId: 'AZ_SUB_ID', variable: 'SID')
                ]) {
                    bat '''
                    az login --service-principal -u %CID% -p %CSEC% --tenant %TID%
                    az account set --subscription %SID%
                    '''
                }
            }
        }

        stage('Deploy Storage Account - DEV') {
            steps {
                bat '''
                echo Deploying Storage Account to DEV...

                az deployment group create ^
                --name dev-sa-deploy-%BUILD_NUMBER% ^
                --resource-group CloudFrame-RG ^
                --template-file arm-templates/storage.json ^
                --mode Incremental

                IF %ERRORLEVEL% NEQ 0 exit /b %ERRORLEVEL%
                '''
            }
        }
    }
}