pipeline {
    agent any

    environment {
        RESOURCE_GROUP = "CloudFrame-RG"
        TEMPLATE_FILE = "azure-adf-e2e/arm-templates/new_resources_dev.json"
    }

    stages {

        stage('Azure Login') {
            steps {
                withCredentials([
                    string(credentialsId: 'AZ_CLIENT_ID', variable: 'CID'),
                    string(credentialsId: 'AZ_CLIENT_SECRET', variable: 'CSEC'),
                    string(credentialsId: 'AZ_TENANT_ID', variable: 'TID'),
                    string(credentialsId: 'AZ_SUB_ID', variable: 'SID')
                ]) {
                    bat '''
                    echo Logging into Azure...

                    az login --service-principal -u %CID% -p %CSEC% --tenant %TID%
                    az account set --subscription %SID%
                    '''
                }
            }
        }

        stage('Validate Template (What-If)') {
            steps {
                bat '''
                echo Running What-If validation...

                az deployment group what-if ^
                --resource-group %RESOURCE_GROUP% ^
                --template-file %TEMPLATE_FILE%
                '''
            }
        }

       stage('Deploy Storage Account - DEV') {
            steps {
                bat '''
                echo ======================================
                echo Deploying Storage Account to DEV...
                echo ======================================

                az deployment group create ^
                --name dev-sa-deploy-%BUILD_NUMBER% ^
                --resource-group %RESOURCE_GROUP% ^
                --template-file %TEMPLATE_FILE% ^
                --mode Incremental ^
                --output none

                IF %ERRORLEVEL% EQU 0 (
                    echo ======================================
                    echo DEPLOYMENT SUCCESSFUL
                    echo ======================================
                ) ELSE (
                    echo DEPLOYMENT FAILED
                    exit /b %ERRORLEVEL%
                )
                '''
            }
        }
    }
}