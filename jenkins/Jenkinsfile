pipeline {
    agent any

    options {
        skipDefaultCheckout(true)   // 🔥 Important: do not use branch code
    }

    environment {
        RESOURCE_GROUP = "CloudFrame-RG"   // Change if you have PROD RG
    }

    stages {

        stage('Clean Workspace') {
            steps {
                deleteDir()
            }
        }

        stage('Download Artifact From CI') {
            steps {
                copyArtifacts(
                    projectName: 'DemoPipeline10',   // 🔥 Your CI job name
                    selector: lastSuccessful(),     // Can change to specific build later
                    fingerprintArtifacts: true
                )
            }
        }

        stage('Azure Login') {
            steps {
                withCredentials([
                    string(credentialsId: 'AZ_CLIENT_ID', variable: 'CID'),
                    string(credentialsId: 'AZ_CLIENT_SECRET', variable: 'CSEC'),
                    string(credentialsId: 'AZ_TENANT_ID', variable: 'TID'),
                    string(credentialsId: 'AZ_SUB_ID', variable: 'SID')
                ]) {
                    bat '''
                    az login --service-principal -u %CID% -p %CSEC% --tenant %TID%
                    az account set --subscription %SID%
                    '''
                }
            }
        }

        stage('Approval Before PROD') {
            steps {
                input message: "Approve deployment to PROD?"
            }
        }

        stage('Deploy Storage Account - PROD') {
            steps {
                bat '''
                az deployment group create ^
                --name prod-storage-%BUILD_NUMBER% ^
                --resource-group %RESOURCE_GROUP% ^
                --template-file azure-adf-e2e\\arm-templates\\storage-account\\storage.json ^
                --parameters storageAccounts_cftproject_name=cfstorage001prod ^
                --mode Incremental ^
                --output none

                IF %ERRORLEVEL% NEQ 0 (
                    echo Deployment failed!
                    exit /b 1
                )

                echo PROD deployment completed successfully.
                '''
            }
        }
    }
}