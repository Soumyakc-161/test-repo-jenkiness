pipeline {
    agent any

    parameters {
        string(name: 'BRANCH_NAME', defaultValue: '', description: 'Enter branch name manually')
    }

    stages {

    /* =====================================================
   1. Branch Validation & Checkout 
====================================================== */
stage('Validate Branch & Checkout') {
    steps {
        script {
            def repoUrl = "https://github.com/Soumyakc-161/test-repo-jenkiness.git"

            // 🔴 Hard stop if parameter is empty
            if (!params.BRANCH_NAME || params.BRANCH_NAME.trim() == "") {
                error "❌ BRANCH_NAME parameter is EMPTY. Pipeline aborted."
            }

            echo "🔍 Branch entered: ${params.BRANCH_NAME}"

            // Clean workspace to avoid cached success
            deleteDir()

            try {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "refs/heads/${params.BRANCH_NAME}"]],
                    userRemoteConfigs: [[
                        url: repoUrl,
                        refspec: "+refs/heads/*:refs/remotes/origin/*"
                    ]],
                    extensions: [
                        [$class: 'CloneOption',
                         shallow: false,
                         noTags: false,
                         timeout: 10]
                    ]
                ])

                echo "✅ Branch '${params.BRANCH_NAME}' VERIFIED and CHECKED OUT"

            } catch (Exception e) {
                error """
❌ STRICT FAILURE: BRANCH DOES NOT EXIST
---------------------------------------
Repository : ${repoUrl}
Branch     : ${params.BRANCH_NAME}
---------------------------------------
Pipeline stopped immediately.
"""
            }
        }
    }
}



        /* =====================================================
           2. Enforce ONLY JSON files in arm-templates
        ====================================================== */
        stage('Validate File Types') {
            steps {
                script {
                    echo "🔍 Enforcing JSON-only policy under arm-templates"

                    def status = bat(
                        script: '''
                        @echo off
                        for /R azure-adf-e2e\\arm-templates %%f in (*) do (
                            if not "%%~xf"==".json" (
                                echo ❌ Invalid file found: %%f
                                exit /b 1
                            )
                        )
                        ''',
                        returnStatus: true
                    )

                    if (status != 0) {
                        error "❌ Non-JSON files detected"
                    }

                    echo "✅ JSON-only validation passed"
                }
            }
        }

        /* =====================================================
           3. Resource Group Template Validation
        ====================================================== */
        stage('Validate - Resource Group Template') {
            steps {
                bat '''
                if not exist azure-adf-e2e\\arm-templates\\resource-group\\rg.json (
                    echo ❌ rg.json missing
                    exit /b 1
                )

                type azure-adf-e2e\\arm-templates\\resource-group\\rg.json >nul || exit /b 1

                echo ✅ Resource Group structure OK
                '''
            }
        }

        /* =====================================================
           4. Storage Account Template Validation
        ====================================================== */
       stage('Validate - Storage Account Template') {
    steps {
        bat '''
        echo Validating Storage Account ARM Template (BAT only)...

        set FILE=azure-adf-e2e\\arm-templates\\storage-account\\storage.json

        REM ===== 1. File exists =====
        if not exist %FILE% (
            echo ERROR: storage.json missing
            exit /b 1
        )

        REM ===== 2. File readable =====
        type %FILE% >nul || (
            echo ERROR: storage.json not readable
            exit /b 1
        )

        REM ===== 3. Required parameter exists =====
        findstr /C:"storageAccounts_cftproject_name" %FILE% >nul || (
            echo ERROR: Missing parameter storageAccounts_cftproject_name
            exit /b 1
        )

        REM ===== 4. Strict storage account name =====
        findstr /C:"\\"defaultValue\\": \\"cftproject\\"" %FILE% >nul || (
            echo ERROR: Storage account name must be cftproject
            exit /b 1
        )

        REM ===== 5. Required resource types =====
        findstr /C:"Microsoft.Storage/storageAccounts\"" %FILE% >nul || (
            echo ERROR: Missing storageAccounts resource
            exit /b 1
        )

        findstr /C:"Microsoft.Storage/storageAccounts/blobServices\"" %FILE% >nul || (
            echo ERROR: Missing blobServices resource
            exit /b 1
        )

        findstr /C:"Microsoft.Storage/storageAccounts/fileServices\"" %FILE% >nul || (
            echo ERROR: Missing fileServices resource
            exit /b 1
        )

        findstr /C:"Microsoft.Storage/storageAccounts/queueServices\"" %FILE% >nul || (
            echo ERROR: Missing queueServices resource
            exit /b 1
        )

        findstr /C:"Microsoft.Storage/storageAccounts/tableServices\"" %FILE% >nul || (
            echo ERROR: Missing tableServices resource
            exit /b 1
        )

        findstr /C:"Microsoft.Storage/storageAccounts/blobServices/containers\"" %FILE% >nul || (
            echo ERROR: Missing blob container resources
            exit /b 1
        )

        echo SUCCESS: Storage Account ARM template validation PASSED
        '''
    }
}


        /* =====================================================
           5. Data Factory Template Structure Validation
        ====================================================== */
        stage('Validate - Data Factory Templates') {
            steps {
                bat '''
                if not exist azure-adf-e2e\\arm-templates\\data-factory\\factory (
                    echo ❌ factory folder missing
                    exit /b 1
                )

                if not exist azure-adf-e2e\\arm-templates\\data-factory\\linkedTemplates (
                    echo ❌ linkedTemplates folder missing
                    exit /b 1
                )

                if not exist azure-adf-e2e\\arm-templates\\data-factory\\ARMTemplateForFactory.json (
                    echo ❌ ARMTemplateForFactory.json missing
                    exit /b 1
                )

                if not exist azure-adf-e2e\\arm-templates\\data-factory\\ARMTemplateParametersForFactory.json (
                    echo ❌ Parameters file missing
                    exit /b 1
                )

                type azure-adf-e2e\\arm-templates\\data-factory\\ARMTemplateForFactory.json >nul || exit /b 1
                type azure-adf-e2e\\arm-templates\\data-factory\\ARMTemplateParametersForFactory.json >nul || exit /b 1

                for %%f in (azure-adf-e2e\\arm-templates\\data-factory\\factory\\*.json) do (
                    type %%f >nul || exit /b 1
                )

                for %%f in (azure-adf-e2e\\arm-templates\\data-factory\\linkedTemplates\\*.json) do (
                    type %%f >nul || exit /b 1
                )

                echo ✅ Data Factory structure OK
                '''
            }
        }

        /* =====================================================
           6. REAL ARM VALIDATION (Azure-side, No Deployment)
        ====================================================== */
        // stage('ARM Validate - Data Factory') {
        //     steps {
        //         echo "🔐 Performing REAL ARM validation (no deployment)"

        //         bat '''
        //         az deployment group validate ^
        //           --resource-group rg-validation ^
        //           --template-file azure-adf-e2e\\arm-templates\\data-factory\\ARMTemplateForFactory.json ^
        //           --parameters azure-adf-e2e\\arm-templates\\data-factory\\ARMTemplateParametersForFactory.json
        //         '''
        //     }
        // }

        /* =====================================================
           7. Publish ARM Templates as Artifact
        ====================================================== */
        stage('Publish ARM Artifact') {
            steps {
                echo "📦 Publishing ARM templates as CI artifact"

                archiveArtifacts artifacts: 'azure-adf-e2e/arm-templates/**/*.json',
                                 fingerprint: true
            }
        }
    }
}
