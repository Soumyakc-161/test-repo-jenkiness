pipeline {
    agent any

    parameters {
        string(name: 'BRANCH_NAME', defaultValue: '', description: 'Enter branch name manually')
    }

    stages {

        stage('Validate Branch & Checkout') {
            steps {
                script {
                    def repoUrl = "https://github.com/Soumyakc-161/test-repo-jenkiness.git"

                    echo "Branch entered: ${params.BRANCH_NAME}"

                    try {
                        checkout([$class: 'GitSCM',
                            branches: [[name: "*/${params.BRANCH_NAME}"]],
                            userRemoteConfigs: [[url: repoUrl]]
                        ])

                        echo "✅ Branch is correct. Checkout successful!"
                    }
                    catch (err) {
                        error "❌ Branch is WRONG or not found: ${params.BRANCH_NAME}"
                    }
                }
            }
        }

        stage('Validate Files') {
            steps {
                script {
                    echo "✅ Validating allowed files..."

                    try {
                        def invalidFiles = sh(
                            script: """
                            find . -type f \
                            ! -name '*.json' \
                            ! -name 'Jenkinsfile' \
                            ! -path './.git/*'
                            """,
                            returnStdout: true
                        ).trim()

                        if (invalidFiles) {
                            error "❌ Invalid files found (only .json + Jenkinsfile allowed):\n${invalidFiles}"
                        }

                        echo "✅ File validation passed (Only .json + Jenkinsfile)"
                    }
                    catch (err) {
                        echo "❌ Validate Files failed, but continuing pipeline"
                    }
                }
            }
        }

        stage('Validate - Resource Group Template') {
    steps {
        echo "🔍 CI: Validating Resource Group ARM template structure"

        bat '''
        echo Checking resource-group folder...
        if not exist azure-adf-e2e\\arm-templates\\resource-group (
            echo ❌ ERROR: resource-group folder is missing
            exit /b 1
        )

        echo Checking rg.json file...
        if not exist azure-adf-e2e\\arm-templates\\resource-group\\rg.json (
            echo ❌ ERROR: rg.json file is missing
            exit /b 1
        )

        echo ✅ Resource Group ARM template validation passed
        '''
    }
}

        stage('CI Validate - Data Factory Templates') {
    steps {
        echo "🔍 CI: Validating Data Factory structure (NO Azure)"

        bat '''
        echo ===== Checking folders =====

        if not exist azure-adf-e2e\\arm-templates\\data-factory (
            echo ❌ data-factory folder missing
            exit /b 1
        )

        if not exist azure-adf-e2e\\arm-templates\\data-factory\\factory (
            echo ❌ factory folder missing
            exit /b 1
        )

        if not exist azure-adf-e2e\\arm-templates\\data-factory\\linkedTemplates (
            echo ❌ linkedTemplates folder missing
            exit /b 1
        )

        echo ===== Checking required files =====

        set FILES= ^
        azure-adf-e2e\\arm-templates\\data-factory\\factory\\CloudFrameDataFactory_ARMTemplateForFactory.json ^
        azure-adf-e2e\\arm-templates\\data-factory\\factory\\CloudFrameDataFactory_ARMTemplateParametersForFactory.json ^
        azure-adf-e2e\\arm-templates\\data-factory\\linkedTemplates\\ArmTemplateParameters_master.json ^
        azure-adf-e2e\\arm-templates\\data-factory\\linkedTemplates\\ArmTemplate_0.json ^
        azure-adf-e2e\\arm-templates\\data-factory\\linkedTemplates\\ArmTemplate_master.json ^
        azure-adf-e2e\\arm-templates\\data-factory\\linkedTemplates\\ARMTemplateForFactory.json ^
        azure-adf-e2e\\arm-templates\\data-factory\\linkedTemplates\\ARMTemplateParametersForFactory.json ^
        azure-adf-e2e\\arm-templates\\data-factory\\ARMTemplateForFactory.json ^
        azure-adf-e2e\\arm-templates\\data-factory\\ARMTemplateParametersForFactory.json

        for %%F in (%FILES%) do (
            if not exist %%F (
                echo ❌ Missing file: %%F
                exit /b 1
            )
            for %%S in (%%F) do if %%~zS==0 (
                echo ❌ Empty file: %%F
                exit /b 1
            )
        )

        echo ===== Validating JSON syntax =====
        for %%F in (%FILES%) do (
            powershell -Command "Get-Content '%%F' | ConvertFrom-Json > $null" || (
                echo ❌ Invalid JSON: %%F
                exit /b 1
            )
        )

        echo ✅ CI Data Factory validation SUCCESS
        '''
    }
}


        stage('ARM What-If - Data Factory') {
            steps {
                echo "🔍 Previewing Azure changes using ARM What-If..."

                sh """
                az deployment group what-if \
                  --resource-group rg-validation \
                  --template-file azure-adf-e2e/arm-templates/data-factory/ARMTemplateForFactory.json \
                  --parameters azure-adf-e2e/arm-templates/data-factory/ARMTemplateParametersForFactory.json
                """
            }
        }

        stage('Publish ARM Artifact') {
            steps {
                echo " Publishing ARM templates as artifact..."

                archiveArtifacts artifacts: 'azure-adf-e2e/arm-templates/**/*.json',
                                 fingerprint: true
            }
        }
    }
}