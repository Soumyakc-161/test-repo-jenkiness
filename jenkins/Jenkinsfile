pipeline {
    agent any

    parameters {
        string(name: 'BRANCH_NAME', defaultValue: '', description: 'Enter branch name manually')
        choice(name: 'ENV', choices: ['DEV'], description: 'Select deployment environment')
    }

    stages {

        stage('Validate Branch & Checkout') {
            steps {
                script {
                    def repoUrl = "https://github.com/Soumyakc-161/test-repo-jenkiness.git"

                    if (!params.BRANCH_NAME || params.BRANCH_NAME.trim() == "") {
                        error " BRANCH_NAME parameter is EMPTY. Pipeline aborted."
                    }

                    echo " Branch entered: ${params.BRANCH_NAME}"
                    deleteDir()

                    try {
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: "refs/heads/${params.BRANCH_NAME}"]],
                            userRemoteConfigs: [[
                                url: repoUrl,
                                refspec: "+refs/heads/*:refs/remotes/origin/*"
                            ]],
                            extensions: [
                                [$class: 'CloneOption',
                                 shallow: false,
                                 noTags: false,
                                 timeout: 10]
                            ]
                        ])

                        echo " Branch '${params.BRANCH_NAME}' VERIFIED and CHECKED OUT"

                    } catch (Exception e) {
                        error """
FAILURE: BRANCH DOES NOT EXIST
---------------------------------------
Repository : ${repoUrl}
Branch     : ${params.BRANCH_NAME}
---------------------------------------
Pipeline stopped immediately.
"""
                    }
                }
            }
        }

        stage('Validate File Types') {
            steps {
                script {
                    echo " Enforcing JSON-only policy under arm-templates"

                    def status = bat(
                        script: '''
                        @echo off
                        for /R azure-adf-e2e\\arm-templates %%f in (*) do (
                            if not "%%~xf"==".json" (
                                echo Invalid file found: %%f
                                exit /b 1
                            )
                        )
                        ''',
                        returnStatus: true
                    )

                    if (status != 0) {
                        error " Non-JSON files detected"
                    }

                    echo " JSON-only validation passed"
                }
            }
        }

        stage('Validate RG - Basics') {
            steps {
                bat '''
                echo  Validating RG Template Basics...

                set FILE=azure-adf-e2e\\arm-templates\\resource-group\\rg.json
                set PSFILE=validate-rg-basic.ps1

                if not exist %FILE% (
                    echo rg.json missing
                    exit /b 1
                )

                echo $ErrorActionPreference = 'Stop' > %PSFILE%
                echo $json = Get-Content '%FILE%' ^| ConvertFrom-Json >> %PSFILE%

                echo $expected = @{ >> %PSFILE%
                echo 'storageAccounts_cftproject_name'='cftproject'; >> %PSFILE%
                echo 'workspaces_cft_databricks_name'='cft_databricks'; >> %PSFILE%
                echo 'virtualNetworks_CFT_Virtual_Network_name'='CFT_Virtual_Network'; >> %PSFILE%
                echo 'accessConnectors_adb_access_connector_name'='adb-access-connector'; >> %PSFILE%
                echo 'networkSecurityGroups_databricksnsgmuuuizl5pkmwk_name'='databricksnsgmuuuizl5pkmwk'; >> %PSFILE%
                echo 'userAssignedIdentities_databricks_uami_autoloader_name'='databricks-uami-autoloader' >> %PSFILE%
                echo } >> %PSFILE%

                echo foreach ($k in $expected.Keys) { >> %PSFILE%
                echo   if (-not $json.parameters.$k) { >> %PSFILE%
                echo     Write-Host \" Missing parameter: $k\" >> %PSFILE%
                echo     exit 1 >> %PSFILE%
                echo   } >> %PSFILE%
                echo   if ($json.parameters.$k.defaultValue -ne $expected[$k]) { >> %PSFILE%
                echo     Write-Host \" Wrong default value for $k\" >> %PSFILE%
                echo     exit 1 >> %PSFILE%
                echo   } >> %PSFILE%
                echo } >> %PSFILE%

                echo $subId = 'cfd34ebb-456e-4c5c-a8da-3d09bc871fef' >> %PSFILE%
                echo $raw = Get-Content '%FILE%' -Raw >> %PSFILE%
                echo $count = ([regex]::Matches($raw, $subId)).Count >> %PSFILE%
                echo if ($count -lt 2) { >> %PSFILE%
                echo   Write-Host \" Subscription ID missing or altered. Found count: $count\" >> %PSFILE%
                echo   exit 1 >> %PSFILE%
                echo } >> %PSFILE%

                echo Write-Host 'RG basic validation PASSED' >> %PSFILE%

                powershell -NoProfile -ExecutionPolicy Bypass -File %PSFILE%
                '''
            }
        }

        stage('Validate RG - Resources') {
            steps {
                bat '''
                echo Validating RG Template Resources...

                set FILE=azure-adf-e2e\\arm-templates\\resource-group\\rg.json
                set PSFILE=validate-rg-resources.ps1

                echo $ErrorActionPreference = 'Stop' > %PSFILE%
                echo $json = Get-Content '%FILE%' ^| ConvertFrom-Json >> %PSFILE%

                echo $requiredTypes = @( >> %PSFILE%
                echo 'Microsoft.Databricks/workspaces', >> %PSFILE%
                echo 'Microsoft.Storage/storageAccounts', >> %PSFILE%
                echo 'Microsoft.Network/virtualNetworks', >> %PSFILE%
                echo 'Microsoft.Network/networkSecurityGroups', >> %PSFILE%
                echo 'Microsoft.ManagedIdentity/userAssignedIdentities', >> %PSFILE%
                echo 'Microsoft.Databricks/accessConnectors', >> %PSFILE%
                echo 'Microsoft.Storage/storageAccounts/blobServices', >> %PSFILE%
                echo 'Microsoft.Storage/storageAccounts/fileServices', >> %PSFILE%
                echo 'Microsoft.Storage/storageAccounts/queueServices', >> %PSFILE%
                echo 'Microsoft.Storage/storageAccounts/tableServices', >> %PSFILE%
                echo 'Microsoft.Storage/storageAccounts/blobServices/containers' >> %PSFILE%
                echo ) >> %PSFILE%

                echo foreach ($type in $requiredTypes) { >> %PSFILE%
                echo   if (-not ($json.resources ^| Where-Object { $_.type -eq $type })) { >> %PSFILE%
                echo     Write-Host \" Missing resource type: $type\" >> %PSFILE%
                echo     exit 1 >> %PSFILE%
                echo   } >> %PSFILE%
                echo } >> %PSFILE%

                echo Write-Host 'RG resource validation PASSED' >> %PSFILE%

                powershell -NoProfile -ExecutionPolicy Bypass -File %PSFILE%
                '''
            }
        }

        stage('Azure SP Login') {
            steps {
                withCredentials([
                    string(credentialsId: 'AZ_CLIENT_ID', variable: 'CID'),
                    string(credentialsId: 'AZ_CLIENT_SECRET', variable: 'CSEC'),
                    string(credentialsId: 'AZ_TENANT_ID', variable: 'TID'),
                    string(credentialsId: 'AZ_SUB_ID', variable: 'SID')
                ]) {
                    bat '''
                    az login --service-principal -u %CID% -p %CSEC% --tenant %TID%
                    az account set --subscription %SID%
                    az account show
                    '''
                }
            }
        }

        stage('ARM What-If') {
            steps {
                bat '''
                az deployment group what-if ^
                --resource-group CloudFrame-RG ^
                --template-file azure-adf-e2e\\arm-templates\\resource-group\\rg.json ^
                --result-format FullResourcePayloads
                '''
            }
        }

        stage('Publish ARM Artifact') {
            steps {
                echo "Publishing ARM templates as CI artifact"
                archiveArtifacts artifacts: 'azure-adf-e2e/arm-templates/**/*.json',
                                 fingerprint: true
            }
        }

        stage('Deploy to DEV') {
            when {
                allOf {
                    expression { params.ENV == 'DEV' }
                    expression { params.BRANCH_NAME == 'feature/test_repo' }
                }
            }
            steps {
                script {
                    echo "Deploying to DEV environment..."

                    withCredentials([
                        string(credentialsId: 'AZ_CLIENT_ID', variable: 'CID'),
                        string(credentialsId: 'AZ_CLIENT_SECRET', variable: 'CSEC'),
                        string(credentialsId: 'AZ_TENANT_ID', variable: 'TID'),
                        string(credentialsId: 'AZ_SUB_ID', variable: 'SID')
                    ]) {
                        bat '''
                        az login --service-principal -u %CID% -p %CSEC% --tenant %TID%
                        az account set --subscription %SID%

                        echo Starting ARM deployment...

                        az deployment group create ^
                        --resource-group CloudFrame-RG ^
                        --template-file azure-adf-e2e\\arm-templates\\resource-group\\rg.json ^
                        --mode Incremental

                        if %ERRORLEVEL% NEQ 0 (
                            echo Deployment failed!
                            exit /b 1
                        )

                        echo Deployment completed successfully!
                        '''
                    }
                }
            }
        }

    }
}