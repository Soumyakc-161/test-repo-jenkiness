pipeline {
    agent any

    parameters {
        string(name: 'BRANCH_NAME', defaultValue: '', description: 'Enter branch name manually')

        
    }

    stages {

    /* =====================================================
   1. Branch Validation & Checkout 
====================================================== */
stage('Validate Branch & Checkout') {
    steps {
        script {
            def repoUrl = "https://github.com/Soumyakc-161/test-repo-jenkiness.git"

            // 🔴 Hard stop if parameter is empty
            if (!params.BRANCH_NAME || params.BRANCH_NAME.trim() == "") {
                error " BRANCH_NAME parameter is EMPTY. Pipeline aborted."
            }

            echo "🔍 Branch entered: ${params.BRANCH_NAME}"

            // Clean workspace to avoid cached success
            deleteDir()

            try {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "refs/heads/${params.BRANCH_NAME}"]],
                    userRemoteConfigs: [[
                        url: repoUrl,
                        refspec: "+refs/heads/*:refs/remotes/origin/*"
                    ]],
                    extensions: [
                        [$class: 'CloneOption',
                         shallow: false,
                         noTags: false,
                         timeout: 10]
                    ]
                ])

                echo "✅ Branch '${params.BRANCH_NAME}' VERIFIED and CHECKED OUT"

            } catch (Exception e) {
                error """
❌ STRICT FAILURE: BRANCH DOES NOT EXIST
---------------------------------------
Repository : ${repoUrl}
Branch     : ${params.BRANCH_NAME}
---------------------------------------
Pipeline stopped immediately.
"""
            }
        }
    }
}



        /* =====================================================
           2. Enforce ONLY JSON files in arm-templates
        ====================================================== */
        stage('Validate File Types') {
            steps {
                script {
                    echo "🔍 Enforcing JSON-only policy under arm-templates"

                    def status = bat(
                        script: '''
                        @echo off
                        for /R azure-adf-e2e\\arm-templates %%f in (*) do (
                            if not "%%~xf"==".json" (
                                echo ❌ Invalid file found: %%f
                                exit /b 1
                            )
                        )
                        ''',
                        returnStatus: true
                    )

                    if (status != 0) {
                        error "❌ Non-JSON files detected"
                    }

                    echo "✅ JSON-only validation passed"
                }
            }
        }

        /* =====================================================
           3. Resource Group Template Validation
        ====================================================== */
stage('Validate RG') {
    steps {
        powershell '''
$f = Get-ChildItem -Recurse -Filter rg.json | Select-Object -First 1
if(!$f){ Write-Host "Error: line=0 | where=file | file=rg.json | missing"; exit 1 }

$rgFound = $false
$i = 0
Get-Content $f.FullName | ForEach-Object {
  $i++

  if($_ -match '/resourceGroups//'){
    Write-Host "Error: line=$i | where=resourceGroup | file=$($f.FullName) | EMPTY"
    exit 1
  }

  if($_ -match '/resourceGroups/([^/"]+)/providers'){
    $rgFound = $true
    if($Matches[1] -notmatch '^[A-Za-z0-9._()-]+$'){
      Write-Host "Error: line=$i | where=resourceGroup | file=$($f.FullName) | invalid name"
      exit 1
    }
  }
}

if(-not $rgFound){
  Write-Host "Error: line=0 | where=resourceGroup | file=$($f.FullName) | missing"
  exit 1
}

Write-Host "RG validation PASSED"
'''
    }
}

       

    

 
  /* =====================================================hi
           4. Storage Account Template Validation
        ====================================================== */
       stage('Validate - Storage Account Basics') {
    steps {
        bat '''
        echo 🔍 Validating Storage Account Template - Basics...

        set FILE=azure-adf-e2e\\arm-templates\\storage-account\\storage.json
        set PSFILE=validate-storage-basics.ps1

        REM ===== File exists =====
        if not exist %FILE% (
            echo ❌ storage.json missing at expected path
            exit /b 1
        )

        REM ===== Create PowerShell script =====
        echo $ErrorActionPreference = 'Stop' > %PSFILE%
        echo $expectedName = 'cftproject' >> %PSFILE%
        echo $json = Get-Content '%FILE%' ^| ConvertFrom-Json >> %PSFILE%

        REM ---- Required parameter ----
        echo if (-not $json.parameters.storageAccounts_cftproject_name) { >> %PSFILE%
        echo     Write-Host '❌ Missing parameter: storageAccounts_cftproject_name' >> %PSFILE%
        echo     exit 1 >> %PSFILE%
        echo } >> %PSFILE%

        REM ---- Strict storage account name ----
        echo $storageName = $json.parameters.storageAccounts_cftproject_name.defaultValue >> %PSFILE%
        echo if ($storageName -ne $expectedName) { >> %PSFILE%
        echo     Write-Host \"❌ Storage account name must be '$expectedName'. Found: $storageName\" >> %PSFILE%
        echo     exit 1 >> %PSFILE%
        echo } >> %PSFILE%

        echo Write-Host '✅ Storage Account basic validation PASSED' >> %PSFILE%

        REM ===== Execute =====
        powershell -NoProfile -ExecutionPolicy Bypass -File %PSFILE%
        '''
    }
}

stage('Validate - Storage Account Resourcess') {
steps {
bat '''
       echo 🔍 Validating Storage Account Template - Resources...

       set FILE=azure-adf-e2e\\arm-templates\\storage-account\\storage.json
       set PSFILE=validate-storage-resources.ps1

       REM ===== Create PowerShell script =====
       echo $ErrorActionPreference = 'Stop' > %PSFILE%
       echo $json = Get-Content '%FILE%' ^| ConvertFrom-Json >> %PSFILE%

       REM ---- Required resource types ----
       echo $requiredTypes = @( >> %PSFILE%
       echo 'Microsoft.Storage/storageAccounts', >> %PSFILE%
       echo 'Microsoft.Storage/storageAccounts/blobServices', >> %PSFILE%
       echo 'Microsoft.Storage/storageAccounts/fileServices', >> %PSFILE%
       echo 'Microsoft.Storage/storageAccounts/queueServices', >> %PSFILE%
       echo 'Microsoft.Storage/storageAccounts/tableServices', >> %PSFILE%
       echo 'Microsoft.Storage/storageAccounts/blobServices/containers' >> %PSFILE%
       echo ) >> %PSFILE%

       echo foreach ($type in $requiredTypes) { >> %PSFILE%
       echo     if (-not ($json.resources ^| Where-Object { $_.type -eq $type })) { >> %PSFILE%
       echo         Write-Host \"❌ Missing resource type: $type\" >> %PSFILE%
       echo         exit 1 >> %PSFILE%
       echo     } >> %PSFILE%
       echo } >> %PSFILE%

       echo Write-Host '✅ Storage Account resource validation PASSED' >> %PSFILE%

       REM ===== Execute =====
       powershell -NoProfile -ExecutionPolicy Bypass -File %PSFILE%
       '''
}
}


        /* ====================================================
           5. Data Factory Template Structure Validation
        ====================================================== */
        stage('Validate - Data Factory Templates') {
            steps {
                bat '''
                if not exist azure-adf-e2e\\arm-templates\\data-factory\\factory (
                    echo ❌ factory folder missing
                    exit /b 1
                )

                if not exist azure-adf-e2e\\arm-templates\\data-factory\\linkedTemplates (
                    echo ❌ linkedTemplates folder missing
                    exit /b 1
                )

                if not exist azure-adf-e2e\\arm-templates\\data-factory\\ARMTemplateForFactory.json (
                    echo ❌ ARMTemplateForFactory.json missing
                    exit /b 1
                )

                if not exist azure-adf-e2e\\arm-templates\\data-factory\\ARMTemplateParametersForFactory.json (
                    echo ❌ Parameters file missing
                    exit /b 1
                )

                type azure-adf-e2e\\arm-templates\\data-factory\\ARMTemplateForFactory.json >nul || exit /b 1
                type azure-adf-e2e\\arm-templates\\data-factory\\ARMTemplateParametersForFactory.json >nul || exit /b 1

                for %%f in (azure-adf-e2e\\arm-templates\\data-factory\\factory\\*.json) do (
                    type %%f >nul || exit /b 1
                )

                for %%f in (azure-adf-e2e\\arm-templates\\data-factory\\linkedTemplates\\*.json) do (
                    type %%f >nul || exit /b 1
                )

                echo ✅ Data Factory structure OK
                '''
            }
        }

        /* =====================================================
           6. REAL ARM VALIDATION (Azure-side, No Deployment)
        ====================================================== */
