pipeline {
    agent any

    parameters {
        string(name: 'BRANCH_NAME', defaultValue: '', description: 'Enter branch name manually')
    }

    stages {

        stage('Validate Branch & Checkout') {
            steps {
                script {
                    def repoUrl = "https://github.com/Soumyakc-161/test-repo-jenkiness.git"

                    echo "Branch entered: ${params.BRANCH_NAME}"

                    try {
                        checkout([$class: 'GitSCM',
                            branches: [[name: "*/${params.BRANCH_NAME}"]],
                            userRemoteConfigs: [[url: repoUrl]]
                        ])

                        echo "✅ Branch is correct. Checkout successful!"
                    }
                    catch (err) {
                        error "❌ Branch is WRONG or not found: ${params.BRANCH_NAME}"
                    }
                }
            }
        }

        stage('Validate Files') {
            steps {
                script {
                    echo "✅ Validating allowed files..."

                    try {
                        def invalidFiles = sh(
                            script: """
                            find . -type f \
                            ! -name '*.json' \
                            ! -name 'Jenkinsfile' \
                            ! -path './.git/*'
                            """,
                            returnStdout: true
                        ).trim()

                        if (invalidFiles) {
                            error "❌ Invalid files found (only .json + Jenkinsfile allowed):\n${invalidFiles}"
                        }

                        echo "✅ File validation passed (Only .json + Jenkinsfile)"
                    }
                    catch (err) {
                        echo "❌ Validate Files failed, but continuing pipeline"
                    }
                }
            }
        }

        stage('Validate - Resource Group Template') {
    steps {
        echo "🔍 CI: Validating Resource Group ARM template structure"

        bat '''
        echo Checking resource-group folder...
        if not exist azure-adf-e2e\\arm-templates\\resource-group (
            echo ❌ ERROR: resource-group folder is missing
            exit /b 1
        )

        echo Checking rg.json file...
        if not exist azure-adf-e2e\\arm-templates\\resource-group\\rg.json (
            echo ❌ ERROR: rg.json file is missing
            exit /b 1
        )

        echo ✅ Resource Group ARM template validation passed
        '''
    }
}

        stage('Validate - Data Factory Templates') {
    steps {
        bat '''
        echo ===============================
        echo CI: Validating Data Factory files
        echo ===============================

        REM 1. data-factory folder must exist
        if not exist azure-adf-e2e\\arm-templates\\data-factory (
            echo ❌ data-factory folder missing
            exit /b 1
        )

        REM 2. factory folder must exist
        if not exist azure-adf-e2e\\arm-templates\\data-factory\\factory (
            echo ❌ factory folder missing
            exit /b 1
        )

        REM 3. linkedTemplates folder must exist
        if not exist azure-adf-e2e\\arm-templates\\data-factory\\linkedTemplates (
            echo ❌ linkedTemplates folder missing
            exit /b 1
        )

        REM 4. Main ARM template must exist
        if not exist azure-adf-e2e\\arm-templates\\data-factory\\ARMTemplateForFactory.json (
            echo ❌ ARMTemplateForFactory.json missing
            exit /b 1
        )

        REM 5. Parameters file must exist
        if not exist azure-adf-e2e\\arm-templates\\data-factory\\ARMTemplateParametersForFactory.json (
            echo ❌ ARMTemplateParametersForFactory.json missing
            exit /b 1
        )

        REM 6. Validate JSON readability (basic syntax check)
        type azure-adf-e2e\\arm-templates\\data-factory\\ARMTemplateForFactory.json >nul || exit /b 1
        type azure-adf-e2e\\arm-templates\\data-factory\\ARMTemplateParametersForFactory.json >nul || exit /b 1

        REM 7. Validate all linked templates JSON
        for %%f in (azure-adf-e2e\\arm-templates\\data-factory\\linkedTemplates\\*.json) do (
            type %%f >nul || exit /b 1
        )

        echo ✅ CI Data Factory validation PASSED
        '''
    }
}
        stage('Validate - Storage Account Template') {
    steps {
        bat '''
        echo ===============================
        echo CI: Validating Storage Account
        echo ===============================

        if not exist azure-adf-e2e\\arm-templates\\storage-account (
            echo ❌ storage-account folder missing
            exit /b 1
        )

        if not exist azure-adf-e2e\\arm-templates\\storage-account\\storage.json (
            echo ❌ storage.json missing
            exit /b 1
        )

        REM Basic JSON readability check
        type azure-adf-e2e\\arm-templates\\storage-account\\storage.json >nul || exit /b 1

        echo ✅ Storage Account validation PASSED
        '''
    }
}


